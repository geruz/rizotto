version: "3"

# server/ and web/ keep their own Taskfiles, run in their own directory; the tasks
# here only forward to them. They are not "includes", because task refuses an
# included Taskfile with dotenv, and server/Taskfile.yml needs .env.
tasks:
    deps:
        desc: Resolve the go and the node dependencies
        cmds:
            - task -d server deps
            - task -d web deps
        silent: true

    start:
        desc: Run the server
        cmds:
            - task -d server start
        silent: true

    test:
        desc: Run the server tests with coverage
        cmds:
            - task -d server test
        silent: true

    lint:
        desc: Run golangci-lint against the server
        cmds:
            - task -d server lint
        silent: true

    gen:
        desc: Regenerate the service bindings{{if .SQL}} and the sqlc queries{{end}}
        cmds:
            - task -d server gen
        silent: true
{{- if .SQL}}

    migrate-up:
        desc: Apply the migrations of every service
        cmds:
            - task -d server migrate-up
        silent: true

    migrate-down:
        desc: Roll back the last migration of every service
        cmds:
            - task -d server migrate-down
        silent: true
{{- end}}

    web:dev:
        desc: Run the React app on :5173, proxying /api to the server
        cmds:
            - task -d web dev
        silent: true

    web:build:
        desc: Build the React app into web/dist
        cmds:
            - task -d web build
        silent: true

    docker:build:
        desc: Build the docker image with the server and the web app
        cmds:
            - docker build -f .docker/Dockerfile -t {{.Slug}} .
