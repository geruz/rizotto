version: "3"

# server/ and web/ keep their own Taskfiles, run in their own directory; the tasks
# here only forward to them. They are not "includes", because task refuses an
# included Taskfile with dotenv, and server/Taskfile.yml needs .env.
tasks:
    deps:
        desc: Resolve the go and the node dependencies
        cmds:
            - task -d server deps
            - task -d web deps
        silent: true

    start:
        desc: Run the server
        cmds:
            - task -d server start
        silent: true

    test:
        desc: Run the server tests with coverage
        cmds:
            - task -d server test
        silent: true

    lint:
        desc: Run golangci-lint against the server
        cmds:
            - task -d server lint
        silent: true

    gen:
        desc: Regenerate the service bindings and the sqlc queries
        cmds:
            - task -d server gen
        silent: true

    db:start:
        desc: Start the local PostgreSQL on :5432
        cmds:
            - task -d server db:start
        silent: true

    db:stop:
        desc: Stop the local PostgreSQL, keeping its data
        cmds:
            - task -d server db:stop
        silent: true

    db:reset:
        desc: Delete the local PostgreSQL together with its data; migrate-up creates it again
        prompt: This deletes every row of the local database. Continue?
        cmds:
            # asked here once; the prompt of server/Taskfile.yml would not see --yes
            - task -d server --yes db:reset
        silent: true

    migrate-up:
        desc: Apply the pending migrations of every service to the local PostgreSQL
        cmds:
            - task -d server migrate-up
        silent: true

    migrate-status:
        desc: List the applied and the pending migrations of every service
        cmds:
            - task -d server migrate-status
        silent: true

    migrate-down:
        desc: "Roll back the last migration of one service: task migrate-down -- item"
        cmds:
            - task -d server migrate-down -- {{`{{.CLI_ARGS}}`}}
        silent: true

    migrate-redo:
        desc: "Roll back the last migration of one service and apply it again: task migrate-redo -- item"
        cmds:
            - task -d server migrate-redo -- {{`{{.CLI_ARGS}}`}}
        silent: true

    migrate-new:
        desc: "Create a migration: task migrate-new -- item add_price_to_items"
        cmds:
            - task -d server migrate-new -- {{`{{.CLI_ARGS}}`}}
        silent: true

    web:dev:
        desc: Run the React app on :5173, proxying /api to the server
        cmds:
            - task -d web dev
        silent: true

    web:build:
        desc: Build the React app into web/dist
        cmds:
            - task -d web build
        silent: true

    docker:build:
        desc: Build the docker image with the server and the web app
        cmds:
            - docker build -f .docker/Dockerfile -t {{.Slug}} .

    docker:build:migrations:
        desc: Build the docker image {{.Slug}}-migrations, which applies the migrations to $DATABASE_URL
        cmds:
            - docker build -f .docker/migrations.Dockerfile -t {{.Slug}}-migrations .
