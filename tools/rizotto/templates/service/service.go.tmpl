// Package {{.Package}} implements the {{.Name}} RPCs. The {{.LowerPlural}} are kept in
// memory: replace the store with a repository once the service gets a database.
package {{.Package}}

import (
	"context"
	"sync"

	"{{.RizottoModule}}/bb"

	"{{.Module}}/services/{{.Lower}}/{{.Lower}}-client"
)
{{if .List}}
const defaultLimit = 10
{{end}}
type {{.Name}}Service struct {
	mu     sync.RWMutex
	{{.LowerPlural}} []{{.Lower}}.{{.Name}}
	lastID int
}

func New{{.Name}}Service() *{{.Name}}Service {
	return &{{.Name}}Service{
		mu:     sync.RWMutex{},
		{{.LowerPlural}}: []{{.Lower}}.{{.Name}}{},
		lastID: 0,
	}
}
{{if .Create}}
func (srv *{{.Name}}Service) Create{{.Name}}RPC(
	_ context.Context,
	req {{.Lower}}.Create{{.Name}}Request,
) ({{.Lower}}.{{.Name}}, bb.ServiceError) {
	if req.Name == "" {
		return {{.Lower}}.{{.Name}}{}, bb.NewInvalidRequestError("name is required")
	}

	srv.mu.Lock()
	defer srv.mu.Unlock()

	srv.lastID++
	created := {{.Lower}}.{{.Name}}{ID: srv.lastID, Name: req.Name}
	srv.{{.LowerPlural}} = append(srv.{{.LowerPlural}}, created)

	return created, nil
}
{{end}}{{if .Read}}
func (srv *{{.Name}}Service) Get{{.Name}}RPC(
	_ context.Context,
	req {{.Lower}}.Get{{.Name}}Request,
) ({{.Lower}}.{{.Name}}, bb.ServiceError) {
	srv.mu.RLock()
	defer srv.mu.RUnlock()

	for _, existing := range srv.{{.LowerPlural}} {
		if existing.ID == req.{{.Name}}ID {
			return existing, nil
		}
	}

	return {{.Lower}}.{{.Name}}{}, bb.NewNotFoundError("{{.Lower}} not found")
}
{{end}}{{if .List}}
func (srv *{{.Name}}Service) Select{{.NamePlural}}RPC(
	_ context.Context,
	req {{.Lower}}.Select{{.NamePlural}}Request,
) ({{.Lower}}.{{.Name}}List, bb.ServiceError) {
	limit, offset := req.Limit, req.Offset
	if limit <= 0 {
		limit = defaultLimit
	}

	if offset < 0 {
		offset = 0
	}

	srv.mu.RLock()
	defer srv.mu.RUnlock()

	page := []{{.Lower}}.{{.Name}}{}
	if offset < len(srv.{{.LowerPlural}}) {
		page = srv.{{.LowerPlural}}[offset:min(offset+limit, len(srv.{{.LowerPlural}}))]
	}

	return {{.Lower}}.{{.Name}}List{
		Offset:      offset,
		Limit:       limit,
		{{.NamePlural}}: page,
	}, nil
}
{{end}}{{if .Update}}
func (srv *{{.Name}}Service) Update{{.Name}}RPC(
	_ context.Context,
	req {{.Lower}}.Update{{.Name}}Request,
) ({{.Lower}}.{{.Name}}, bb.ServiceError) {
	if req.Name == "" {
		return {{.Lower}}.{{.Name}}{}, bb.NewInvalidRequestError("name is required")
	}

	srv.mu.Lock()
	defer srv.mu.Unlock()

	for i, existing := range srv.{{.LowerPlural}} {
		if existing.ID == req.{{.Name}}ID {
			srv.{{.LowerPlural}}[i].Name = req.Name

			return srv.{{.LowerPlural}}[i], nil
		}
	}

	return {{.Lower}}.{{.Name}}{}, bb.NewNotFoundError("{{.Lower}} not found")
}
{{end}}{{if .Delete}}
func (srv *{{.Name}}Service) Delete{{.Name}}RPC(
	_ context.Context,
	req {{.Lower}}.Delete{{.Name}}Request,
) ({{.Lower}}.Deleted{{.Name}}, bb.ServiceError) {
	srv.mu.Lock()
	defer srv.mu.Unlock()

	for i, existing := range srv.{{.LowerPlural}} {
		if existing.ID == req.{{.Name}}ID {
			srv.{{.LowerPlural}} = append(srv.{{.LowerPlural}}[:i], srv.{{.LowerPlural}}[i+1:]...)

			return {{.Lower}}.Deleted{{.Name}}{ {{.Name}}ID: req.{{.Name}}ID}, nil
		}
	}

	return {{.Lower}}.Deleted{{.Name}}{}, bb.NewNotFoundError("{{.Lower}} not found")
}
{{end}}
{{- end}}
