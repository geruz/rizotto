{{if .Create -}}
-- name: Create{{.Name}} :one
INSERT INTO public.{{.LowerPlural}} (name)
VALUES ($1)
RETURNING *;
{{end}}{{if .Read}}
-- name: Get{{.Name}} :one
SELECT *
FROM public.{{.LowerPlural}}
WHERE id = $1;
{{end}}{{if .List}}
-- name: Select{{.NamePlural}} :many
SELECT *
FROM public.{{.LowerPlural}}
ORDER BY created_at DESC
LIMIT $1 OFFSET $2;
{{end}}{{if .Update}}
-- name: Update{{.Name}} :one
UPDATE public.{{.LowerPlural}}
SET name = $2,
    updated_at = NOW()
WHERE id = $1
RETURNING *;
{{end}}{{if .Delete}}
-- name: Delete{{.Name}} :one
DELETE FROM public.{{.LowerPlural}}
WHERE id = $1
RETURNING *;
{{end}}
