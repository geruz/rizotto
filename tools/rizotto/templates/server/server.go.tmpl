package main

import (
	"context"

	"{{.RizottoModule}}"
	"{{.RizottoModule}}/gateway"
	"{{.RizottoModule}}/pg"
	"{{.RizottoModule}}/settings/env"

	itemsrv "{{.Module}}/services/item"
	"{{.Module}}/services/item/item-client"
)

func main() {
	ctx := context.Background()
	rizotto.MustInitEnv(ctx)
	rizotto.MustInitLogger(ctx)

	rizotto.MustInitMetrics(ctx, ":"+env.GetStringValue("METRICS_PORT", "9091"))
	rizotto.MustInitTracer(ctx, map[string]string{
		"service.name":    env.MustGetStringValue("SERVICE_NAME"),
		"service.version": env.MustGetStringValue("SERVICE_VERSION"),
		"environment":     env.MustGetStringValue("ENVIRONMENT"),
	})

	gt := gateway.NewHTTPGateway()

	// The docker image puts the built web app into STATIC_DIR; locally the app is
	// served by "task web:dev" instead, and the variable stays empty.
	staticDir := env.GetStringValue("STATIC_DIR", "")
	if staticDir != "" {
		gt = gt.Static("/", staticDir)
	}

	pgPool := pg.MustOpenConnection(ctx, env.MustGetStringValue("DATABASE_URL"))

	item.RegisterServer(
		itemsrv.NewItemService(pgPool),
	)

	err := gt.Routing(
		gateway.JoinRouteTables(
		// add the route tables of the controllers here:
		// api.NewSomeController().RouteTable(),
		),
	).ListenAndServe(ctx, ":"+env.GetStringValue("PORT", "9090"))
	if err != nil {
		panic(err)
	}
}
