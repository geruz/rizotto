version: "3"
dotenv: [".env"]
vars:
    SQLC_VERSION: 1.31.1
tasks:
    deps:
        desc: Resolve go dependencies
        cmds:
            - go mod tidy
        silent: true

    start:
        desc: Run the service, starting the local PostgreSQL first
        cmds:
            - task: db:start
            - go run .
        silent: true

    test:
        desc: Run the tests with coverage
        cmds:
            - mkdir -p out
            - go test ./... -coverprofile=out/cover.out
            - go tool cover -func ./out/cover.out
        silent: true

    lint:
        desc: Run golangci-lint against the whole module
        cmds:
            - golangci-lint run ./...
        silent: true

    gen:
        desc: Regenerate the service bindings and the sqlc queries
        cmds:
            - PATH="$(go env GOPATH)/bin:$PATH" go generate ./...
            - docker run --rm --user "$(id -u):$(id -g)" -v "$(pwd):/src" -w /src sqlc/sqlc:{{`{{.SQLC_VERSION}}`}} generate

    # The db:* and migrate-* tasks act on the PostgreSQL of docker-compose.yml only,
    # whatever DATABASE_URL says: a real environment is migrated by the image of
    # .docker/migrations.Dockerfile. scripts/migrate.sh describes the commands.
    db:start:
        desc: Start the local PostgreSQL on :5432
        cmds:
            - docker compose up --detach --wait postgres

    db:stop:
        desc: Stop the local PostgreSQL, keeping its data
        cmds:
            - docker compose stop postgres

    db:reset:
        desc: Delete the local PostgreSQL together with its data; migrate-up creates it again
        prompt: This deletes every row of the local database. Continue?
        cmds:
            - docker compose down --volumes

    migrate-up:
        desc: Apply the pending migrations of every service to the local PostgreSQL
        cmds:
            - task: dbmate
              vars: { ARGS: up }

    migrate-status:
        desc: List the applied and the pending migrations of every service
        cmds:
            - task: dbmate
              vars: { ARGS: status }

    migrate-down:
        desc: "Roll back the last migration of one service: task migrate-down -- item"
        cmds:
            - task: dbmate
              vars: { ARGS: "down {{`{{.CLI_ARGS}}`}}" }

    migrate-redo:
        desc: "Roll back the last migration of one service and apply it again: task migrate-redo -- item"
        cmds:
            - task: dbmate
              vars: { ARGS: "redo {{`{{.CLI_ARGS}}`}}" }

    migrate-new:
        desc: "Create a migration: task migrate-new -- item add_price_to_items"
        cmds:
            - task: dbmate
              vars: { ARGS: "new {{`{{.CLI_ARGS}}`}}" }

    dbmate:
        internal: true
        cmds:
            # --user keeps the files dbmate creates owned by you rather than root
            - docker compose run --rm --user "$(id -u):$(id -g)" dbmate {{`{{.ARGS}}`}}
