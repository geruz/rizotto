# The .env of the image. The defaults come from server/.env.example, copied next
# to it; the values below replace the ones that differ in a container, and the
# variables given to the container (docker run -e) replace both.
IMPORT_ENV_FILES=.env.example
LOG_LEVEL=info
ENVIRONMENT=production
# the web app built by the Dockerfile, served from /
STATIC_DIR=/app/static
{{- if .SQL}}
# DATABASE_URL has no default here: pass it to the container.
{{- end}}
