func testFileContentCase(t *testing.T, ctr FileController, cfg api.RequestConfiguration) {
	t.Helper()
	// arrange
	expires := time.Now().UTC().Add(time.Minute).Truncate(time.Second)
	mock.RPC(&ctr.getFileLinkRPC).Success(file.Link{URL: testLinkURL, ExpiresAt: expires})

	// act
	call := api.TestAPICall(t, ctr, ctr.fileContent, authenticate(cfg).WithPathVar("file_id", "7")).
		ExpectedRequest(t, FileRequest{FileID: testFileID})
{{if .Redirect}}
	// assert: the caller is sent to the storage, which serves the bytes
	call.ExpectedRedirect(t, http.StatusFound, testLinkURL)
{{else}}
	// assert: the link travels in the answer
	call.AddInDocumentation(t, "OK").
		ExpectedResponse(t, Download{URL: testLinkURL, ExpiresAt: expires})
{{end}}}

