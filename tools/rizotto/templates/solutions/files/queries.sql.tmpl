-- name: CreateFile :one
INSERT INTO public.files (user_id, object_key, name, content_type, size_bytes)
VALUES ($1, $2, $3, $4, $5)
RETURNING *;

-- Every read is scoped by user_id, so a file of somebody else answers no rows
-- rather than a forbidden: the service must not confirm that it exists.
-- name: GetFile :one
SELECT *
FROM public.files
WHERE id = $1
    AND user_id = $2;

-- name: SelectFiles :many
SELECT *
FROM public.files
WHERE user_id = sqlc.arg('user_id')
ORDER BY created_at DESC, id DESC
LIMIT sqlc.arg('limit')::bigint OFFSET sqlc.arg('offset')::bigint;

-- name: MarkFileReady :one
UPDATE public.files
SET status = 'ready',
    size_bytes = $3,
    updated_at = NOW()
WHERE id = $1
    AND user_id = $2
RETURNING *;

-- name: DeleteFile :one
DELETE FROM public.files
WHERE id = $1
    AND user_id = $2
RETURNING *;
