const (
	// adminSession belongs to adminID, who is granted permissions.UsersManage;
	// memberSession to memberID, who is granted nothing.
	adminSession  = "an-admin-session"
	memberSession = "a-member-session"
	adminID       = 1
	memberID      = 2
	testEmail     = "person@example.com"
	testName      = "A Person"
	testRole      = "editor"
	testGroup     = "Accounting"
)

// TestMain registers a stub user service knowing two sessions and grants the
// admin permissions.UsersManage, so the tests go through the real area function.
func TestMain(m *testing.M) {
	err := os.Setenv("APP_LOGIN_REDIRECT_URL", "http://localhost:3000")
	if err != nil {
		panic(err)
	}

	user.RegisterServer(stubUserService{})
	accesstest.Register(map[int][]permissions.Permission{adminID: {permissions.UsersManage}})

	os.Exit(m.Run())
}

type stubUserService struct{}

func (stubUserService) GetUserRPC(_ context.Context, req user.GetUserRequest) (user.User, bb.ServiceError) {
	return user.User{ID: req.UserID, Email: testEmail, Name: testName}, nil
}

func (stubUserService) GetUserByEmailRPC(
	_ context.Context, req user.GetUserByEmailRequest,
) (user.User, bb.ServiceError) {
	return user.User{ID: adminID, Email: req.Email, Name: testName}, nil
}

func (stubUserService) CreateUserRPC(_ context.Context, req user.CreateUserRequest) (user.User, bb.ServiceError) {
	return user.User{ID: adminID, Email: req.Email, Name: req.Name}, nil
}

func (stubUserService) CreateSessionRPC(
	_ context.Context, req user.CreateSessionRequest,
) (user.Session, bb.ServiceError) {
	return user.Session{
		Token:     adminSession,
		ExpiresAt: time.Now().UTC().Add(time.Hour),
		User:      user.User{ID: req.UserID, Email: testEmail, Name: testName},
	}, nil
}

func (stubUserService) GetSessionRPC(
	_ context.Context, req user.GetSessionRequest,
) (user.Session, bb.ServiceError) {
	sessions := map[string]int{adminSession: adminID, memberSession: memberID}

	userID, found := sessions[req.Token]
	if !found {
		return user.Session{}, bb.NewUnauthorizedError("unknown session")
	}

	return user.Session{
		Token:     "",
		ExpiresAt: time.Now().UTC().Add(time.Hour),
		User:      user.User{ID: userID, Email: testEmail, Name: testName},
	}, nil
}

func (stubUserService) DeleteSessionRPC(
	_ context.Context, _ user.DeleteSessionRequest,
) (user.DeletedSession, bb.ServiceError) {
	return user.DeletedSession{Deleted: true}, nil
}

// asAdmin makes the request carry the session of the admin, asMember the one of a
// user granted nothing.
func asAdmin(cfg api.RequestConfiguration) api.RequestConfiguration {
	return cfg.WithRequest(appapi.SessionRequest(adminSession))
}

func asMember(cfg api.RequestConfiguration) api.RequestConfiguration {
	return cfg.WithRequest(appapi.SessionRequest(memberSession))
}

func testGroupAnswer() access.Group {
	return access.Group{ID: 1, Name: testGroup, RoleIDs: []int{1}, MemberIDs: []int{adminID}}
}

func expectedGroup() Group {
	return Group{ID: 1, Name: testGroup, RoleIDs: []int{1}, MemberIDs: []int{adminID}}
}

func Test_ListPermissionsRoute(t *testing.T) {
	t.Parallel()

	api.GroupRouteTests(t, "GET /api/v1/admin/permissions", NewAccessController).
		Documentation(
			doc.ApiPublicDocumentationV1,
			openapi.Description("Lists the permissions a role can be granted."),
		).
		Case("listed", testListPermissionsCase).
		Case("without a session", testWithoutSessionCase).
		Case("without the permission", testWithoutPermissionCase)
}

func testListPermissionsCase(t *testing.T, ctr AccessController, cfg api.RequestConfiguration) {
	t.Helper()

	// act
	api.TestAPICall(t, ctr, ctr.listPermissions, asAdmin(cfg)).
		AddInDocumentation(t, "OK").
		ExpectedResponse(t, PermissionList{Permissions: []string{string(permissions.UsersManage)}})
}

// testWithoutSessionCase and testWithoutPermissionCase pin the area function of
// every route of the controller: they all share it.
func testWithoutSessionCase(t *testing.T, ctr AccessController, cfg api.RequestConfiguration) {
	t.Helper()

	// act
	api.TestAPICall(t, ctr, ctr.listPermissions, cfg).
		ExpectedError(t, gateway.NewUnauthorizedError("Authentication required"))
}

func testWithoutPermissionCase(t *testing.T, ctr AccessController, cfg api.RequestConfiguration) {
	t.Helper()

	// act
	api.TestAPICall(t, ctr, ctr.listPermissions, asMember(cfg)).
		AddInDocumentation(t, "A caller without the permission").
		ExpectedError(t, gateway.NewForbiddenError(
			gateway.ForbiddenErrorCode, "Forbidden", "The caller is not granted what this route requires",
		))
}

