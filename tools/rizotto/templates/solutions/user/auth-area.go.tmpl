package api

import (
	"net/http"
{{- if .RBAC}}
	"slices"
{{- end}}
	"sync"
	"time"

	"{{.RizottoModule}}"
	"{{.RizottoModule}}/gateway"
	"{{.RizottoModule}}/settings/env"

{{- if .RBAC}}

	"{{.PermissionsImport}}"
	access "{{.AccessClientImport}}"
{{- end}}
	user "{{.ClientImport}}"
)

// SessionCookieName is the cookie the session token travels in.
const SessionCookieName = "{{.SessionCookieName}}"

// SessionUser is the caller of an authenticated route. It is a type of its own
// rather than the CurrentUser placeholder of controller.go, so that installing a
// solution does not rewrite a file the project may have edited.
type SessionUser struct {
	ID    int
	Email string
	Name  string
{{- if .RBAC}}
	// Permissions are what the groups of the user are granted. Only Require reads
	// them: behind AuthArea they stay empty, and Can answers false.
	Permissions []permissions.Permission
{{- end}}
}
{{- if .RBAC}}

// Can tells whether the user is granted the permission.
func (u SessionUser) Can(permission permissions.Permission) bool {
	return slices.Contains(u.Permissions, permission)
}
{{- end}}

// AuthHTTPContext is the context of the routes AuthArea guards. A handler taking
// it can rely on User being there: the request never reaches it otherwise.
type AuthHTTPContext struct {
	rizotto.HTTPContext

	User SessionUser
}

{{- if .RBAC}}
//nolint:gochecknoglobals // one value shared by every private route
var (
	unauthorized = gateway.NewUnauthorizedError("Authentication required")
	forbidden    = gateway.NewForbiddenError(
		gateway.ForbiddenErrorCode, "Forbidden", "The caller is not granted what this route requires",
	)
)
{{- else}}
//nolint:gochecknoglobals // one value shared by every private route
var unauthorized = gateway.NewUnauthorizedError("Authentication required")
{{- end}}

// The session reader is bound on first use: the area function is referenced while
// the controllers are built, which happens before the service is registered.
//
//nolint:gochecknoglobals // the binding is process wide, like the bb registry
var (
	getSession     user.GetSessionRPC
	getSessionOnce sync.Once
)

func sessionReader() user.GetSessionRPC {
	getSessionOnce.Do(func() {
		getSession = user.BindClient().GetSessionRPC
	})

	return getSession
}
{{- if .RBAC}}

//nolint:gochecknoglobals // the binding is process wide, like the bb registry
var (
	getPermissions     access.GetUserPermissionsRPC
	getPermissionsOnce sync.Once
)

func permissionReader() access.GetUserPermissionsRPC {
	getPermissionsOnce.Do(func() {
		getPermissions = access.BindClient().GetUserPermissionsRPC
	})

	return getPermissions
}
{{- end}}

// AuthArea builds the context of the routes that require an authenticated user.
// Answering an error rejects the request before the handler runs.
func AuthArea(ctx rizotto.HTTPContext) (AuthHTTPContext, rizotto.HTTPError) {
	empty := AuthHTTPContext{
		HTTPContext: ctx,
		User:        SessionUser{ID: 0, Email: "", Name: ""{{if .RBAC}}, Permissions: nil{{end}}},
	}

	token, found := SessionToken(ctx)
	if !found {
		return empty, unauthorized
	}

	session, err := sessionReader()(ctx, user.GetSessionRequest{Token: token})
	if err != nil {
		return empty, gateway.MapError(err).IfUnauthorized(unauthorized).Others(gateway.NewInternalError())
	}

	return AuthHTTPContext{
		HTTPContext: ctx,
		User: SessionUser{
			ID:    session.User.ID,
			Email: session.User.Email,
			Name:  session.User.Name,
{{- if .RBAC}}
			Permissions: nil,
{{- end}}
		},
	}, nil
}
{{- if .RBAC}}

// Require builds the area function of the routes that need permissions: the
// caller has to be authenticated, as with AuthArea, and granted every one of
// required, or the request is answered 403 before the handler runs. Behind it
// ctx.User.Permissions holds everything the caller is granted, so Require() with
// no permission at all is how a route reads them without requiring any.
func Require(
	required ...permissions.Permission,
) func(ctx rizotto.HTTPContext) (AuthHTTPContext, rizotto.HTTPError) {
	return func(ctx rizotto.HTTPContext) (AuthHTTPContext, rizotto.HTTPError) {
		authenticated, httpErr := AuthArea(ctx)
		if httpErr != nil {
			return authenticated, httpErr
		}

		granted, err := permissionReader()(ctx, access.GetUserPermissionsRequest{UserID: authenticated.User.ID})
		if err != nil {
			return authenticated, gateway.MapError(err).Others(gateway.NewInternalError())
		}

		for _, permission := range granted.Permissions {
			authenticated.User.Permissions = append(authenticated.User.Permissions, permissions.Permission(permission))
		}

		for _, permission := range required {
			if !authenticated.User.Can(permission) {
				return authenticated, forbidden
			}
		}

		return authenticated, nil
	}
}
{{- end}}

// SessionToken reads the session token of the request.
func SessionToken(ctx rizotto.HTTPContext) (string, bool) {
{{if .Cookie}}	return gateway.Cookie(ctx, SessionCookieName)
{{else}}	const prefix = "Bearer "

	header := ctx.Request.Header.Get("Authorization")
	if len(header) <= len(prefix) || header[:len(prefix)] != prefix {
		return "", false
	}

	return header[len(prefix):], true
{{end}}}

// SessionRequest makes a request carry a session, whichever way sessions travel
// here. It is what the route tests of other packages authenticate with, so that
// only this file knows the mechanism.
func SessionRequest(token string) func(*http.Request) error {
	return func(req *http.Request) error {
{{if .Cookie}}		req.AddCookie(&http.Cookie{Name: SessionCookieName, Value: token}) //nolint:exhaustruct_v5 // a request cookie is a name and a value
{{else}}		req.Header.Set("Authorization", "Bearer "+token)
{{end}}
		return nil
	}
}

// HandOverSession gives a fresh session to the caller and answers where to send
// them next. Whoever logged the caller in calls this instead of knowing how the
// session travels.
{{if .Cookie}}func HandOverSession(ctx gateway.ExtendedHTTPContext, token string, expiresAt time.Time) string {
	gateway.SetCookie(ctx, gateway.NewSessionCookie(SessionCookieName, token, time.Until(expiresAt)))

	return AppRedirectURL()
}
{{else}}func HandOverSession(_ gateway.ExtendedHTTPContext, token string, _ time.Time) string {
	// The token rides the fragment, which browsers keep out of both requests and
	// server logs.
	return AppRedirectURL() + "#token=" + token
}
{{end}}
// DropSession takes the session away from the caller.
func DropSession(ctx gateway.ExtendedHTTPContext) {
{{if .Cookie}}	gateway.SetCookie(ctx, gateway.NewExpiredCookie(SessionCookieName))
{{else}}	// Nothing to drop: the caller keeps the token itself.
	_ = ctx
{{end}}}

// AppRedirectURL is where the caller lands once the login is over.
func AppRedirectURL() string {
	return env.MustGetStringValue("APP_LOGIN_REDIRECT_URL")
}
