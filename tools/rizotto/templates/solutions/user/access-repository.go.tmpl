// inTx runs the queries in one transaction, committed only when all of them
// succeed.
func (r AccessRepository) inTx(ctx context.Context, run func(q *db.Queries) error) error {
	tx, err := r.Conn().Begin(ctx)
	if err != nil {
		return fmt.Errorf("begin the transaction: %w", err)
	}

	defer func() { _ = tx.Rollback(ctx) }()

	err = run(r.queries.WithTx(tx))
	if err != nil {
		return err
	}

	return tx.Commit(ctx)
}

func addRolePermissions(ctx context.Context, q *db.Queries, roleID int64, permissions []string) error {
	for _, permission := range permissions {
		err := q.AddRolePermission(ctx, db.AddRolePermissionParams{RoleID: roleID, Permission: permission})
		if err != nil {
			return err
		}
	}

	return nil
}
