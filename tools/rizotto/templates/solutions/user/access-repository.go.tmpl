// CreateRole creates the role together with its permissions, or nothing at all.
func (r AccessRepository) CreateRole(ctx context.Context, name string, permissions []string) (db.Role, error) {
	var role db.Role

	err := r.inTx(ctx, func(q *db.Queries) error {
		var err error

		role, err = q.CreateRole(ctx, name)
		if err != nil {
			return err
		}

		return addRolePermissions(ctx, q, role.ID, permissions)
	})

	return role, err
}

// UpdateRole renames the role and replaces its permissions in one go.
func (r AccessRepository) UpdateRole(
	ctx context.Context, id int64, name string, permissions []string,
) (db.Role, error) {
	var role db.Role

	err := r.inTx(ctx, func(q *db.Queries) error {
		var err error

		role, err = q.UpdateRole(ctx, db.UpdateRoleParams{ID: id, Name: name})
		if err != nil {
			return err
		}

		err = q.ClearRolePermissions(ctx, id)
		if err != nil {
			return err
		}

		return addRolePermissions(ctx, q, id, permissions)
	})

	return role, err
}

// EnsureRole answers the role of that name, creating it when it is missing, and
// grants it the permissions on top of whatever it has.
func (r AccessRepository) EnsureRole(ctx context.Context, name string, permissions []string) (db.Role, error) {
	var role db.Role

	err := r.inTx(ctx, func(q *db.Queries) error {
		var err error

		role, err = q.EnsureRole(ctx, name)
		if err != nil {
			return err
		}

		return addRolePermissions(ctx, q, role.ID, permissions)
	})

	return role, err
}

