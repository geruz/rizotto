package repository

import (
	"context"
	"fmt"

	"github.com/jackc/pgx/v5/pgxpool"

	"{{.RizottoModule}}/pg"

	"{{.Module}}/{{.Dir}}/repository/db"
)

// AccessRepository reads and writes the groups, the roles and what they grant.
type AccessRepository struct {
	pg.Repository

	queries *db.Queries
}

func NewAccessRepository(pool *pgxpool.Pool) AccessRepository {
	return AccessRepository{
		Repository: pg.NewRepository(pool),
		queries:    db.New(pool),
	}
}

func (r AccessRepository) GetUserPermissions(ctx context.Context, userID int64) ([]string, error) {
	return r.queries.GetUserPermissions(ctx, userID)
}

