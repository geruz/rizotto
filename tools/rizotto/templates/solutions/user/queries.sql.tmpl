-- name: GetUser :one
SELECT *
FROM public.users
WHERE id = $1;

-- The email is not unique: at most two rows are read, which is enough to tell one
-- user from several.
-- name: FindUsersByEmail :many
SELECT *
FROM public.users
WHERE lower(email) = lower($1)
ORDER BY id
LIMIT 2;

-- name: CreateUser :one
INSERT INTO public.users (email, name)
VALUES ($1, $2)
RETURNING *;

-- name: CreateSession :one
INSERT INTO public.sessions (token_hash, user_id, expires_at)
VALUES ($1, $2, $3)
RETURNING *;

-- GetSession answers the session together with its user, so that authenticating a
-- request is a single round trip.
-- name: GetSession :one
SELECT s.token_hash, s.expires_at, u.id, u.email, u.name
FROM public.sessions s
    JOIN public.users u ON u.id = s.user_id
WHERE s.token_hash = $1;

-- name: DeleteSession :one
DELETE FROM public.sessions
WHERE token_hash = $1
RETURNING token_hash;
