	}

	return toGroup(updated, 0), nil
}

// answerError turns an error of the services into the answer of a route. The
// services answer a validation error for what the caller got wrong, which is
// told apart by its code rather than taken for an internal error.
func answerError(err bb.ServiceError, notFound gateway.HTTPError) gateway.HTTPError {
	switch {
	case bb.IsValidationErrorWithCode(err, access.NameTakenCode):
		return nameTaken
	case bb.IsValidationErrorWithCode(err, access.UnknownPermissionCode):
		return unknownPermission
	case bb.IsValidationErrorWithCode(err, gateway.InvalidRequestErrorCode):
		return invalidRequest
	default:
		return gateway.MapError(err).IfNotFound(notFound).Others(internalError)
	}
}

func toUser(src user.User, _ int) User {
	return User{ID: src.ID, Email: src.Email, Name: src.Name}
}

func toRole(src access.Role, _ int) Role {
	return Role{ID: src.ID, Name: src.Name, Permissions: src.Permissions}
}

func toGroup(src access.Group, _ int) Group {
	return Group{ID: src.ID, Name: src.Name, RoleIDs: src.RoleIDs, MemberIDs: src.MemberIDs}
}
